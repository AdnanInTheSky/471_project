# MongoDB Atlas Connection String
# Leave empty locally to use the built-in local JSON database fallback (.data/motosheba-local.json)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/motosheba?retryWrites=true&w=majority

# Database Name (defaults to motosheba)
MONGODB_DB=motosheba

# JWT Secret for httpOnly session cookies
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-chars

# Local Development Port
PORT=3000
